<Window x:Class="YitDesktopFold.Native.GlobalDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="390"
        SizeToContent="Height"
        MaxHeight="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="#FF272A2E"
        ShowInTaskbar="True"
        ShowActivated="True"
        Topmost="False"
        Opacity="0"
        FontFamily="{StaticResource UiFont}"
        Foreground="#F7F8F9"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="#F2F3F4" />
            <Setter Property="Background" Value="#16FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#48FFFFFF"
                                BorderThickness="0"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.68" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#F1F2F3" />
            <Setter Property="Foreground" Value="#24272B" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Background="#FF272A2E" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="WindowScale" ScaleX="0.985" ScaleY="0.985" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock x:Name="TitleText"
                       Margin="18,0,48,0"
                       VerticalAlignment="Center"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.HeadingLevel="Level1" />
            <Button Width="30"
                    Height="30"
                    Margin="0,6,8,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#BFC4C8CC"
                    FontSize="16"
                    FocusVisualStyle="{x:Null}"
                    Content="×"
                    Cursor="Hand"
                    AutomationProperties.Name="关闭"
                    Click="CloseButton_Click" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="20,2,20,20">
            <ScrollViewer MaxHeight="140"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden">
                <TextBlock x:Name="MessageText"
                           FontSize="12.5"
                           LineHeight="20"
                           Foreground="#C5C9CCCF"
                           TextWrapping="Wrap" />
            </ScrollViewer>

            <Border x:Name="InputShell"
                    Height="38"
                    Margin="0,14,0,0"
                    Padding="10,0"
                    Background="#70202327"
                    BorderBrush="#38FFFFFF"
                    BorderThickness="1"
                    CornerRadius="7"
                    Visibility="Collapsed">
                <TextBox x:Name="InputTextBox"
                         MaxLength="32"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#F5F6F7"
                         CaretBrush="#F5F6F7"
                         SelectionBrush="#66787C80"
                         FontSize="13"
                         TextChanged="InputTextBox_TextChanged" />
            </Border>

            <TextBlock x:Name="ErrorText"
                       Margin="2,6,2,0"
                       FontSize="11.5"
                       Foreground="#E7B3A9"
                       Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Assertive" />

            <StackPanel Margin="0,18,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Style="{StaticResource DialogButtonStyle}"
                        Click="CancelButton_Click" />
                <Button x:Name="SecondaryButton"
                        Style="{StaticResource DialogButtonStyle}"
                        Click="SecondaryButton_Click" />
                <Button x:Name="PrimaryButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="PrimaryButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
