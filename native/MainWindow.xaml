<Window x:Class="YitDesktopFold.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:YitDesktopFold.Native.Controls"
        xmlns:models="clr-namespace:YitDesktopFold.Native.Models"
        mc:Ignorable="d"
        Title="Yit Desktop Fold"
        Width="444"
        Height="340"
        MinWidth="1"
        MinHeight="120"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        FontFamily="{StaticResource UiFont}"
        Foreground="#F7F9FF"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AutomationProperties.Name="桌面项目整理块"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ShortcutFocusVisualStyle" TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}">
                        <Border Width="18"
                                Height="2"
                                Margin="0,0,0,2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="1"
                                Opacity="0.48" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#F4F5F6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Padding="10,6"
                                Background="#F0272A2E"
                                BorderBrush="#2EFFFFFF"
                                BorderThickness="1"
                                CornerRadius="7">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GridShortcutContentTemplate">
            <Grid Margin="4,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image Grid.Row="0"
                       Margin="2,1"
                       Source="{Binding Icon}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Width" Value="62" />
                            <Setter Property="Height" Value="62" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type controls:AdaptiveIconPanel}}}"
                                             Value="{x:Static models:OrganizerIconLayoutMode.Medium}">
                                    <Setter Property="Width" Value="48" />
                                    <Setter Property="Height" Value="48" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type controls:AdaptiveIconPanel}}}"
                                             Value="{x:Static models:OrganizerIconLayoutMode.Small}">
                                    <Setter Property="Width" Value="34" />
                                    <Setter Property="Height" Value="34" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <TextBlock Grid.Row="1"
                           Height="14"
                           Margin="1,4,1,0"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="Normal"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                           LineHeight="14"
                           Text="{Binding Name}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AreLabelsVisible, RelativeSource={RelativeSource AncestorType={x:Type controls:AdaptiveIconPanel}}}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ListShortcutContentTemplate">
            <Grid Margin="5,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="28"
                       Height="28"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Source="{Binding Icon}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Grid.Column="1"
                           Margin="8,0,6,0"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>

        <Style x:Key="ShortcutButtonStyle" TargetType="Button">
            <EventSetter Event="MouseEnter" Handler="ShortcutButton_MouseEnter" />
            <EventSetter Event="MouseLeave" Handler="ShortcutButton_MouseLeave" />
            <EventSetter Event="PreviewMouseDown" Handler="ShortcutButton_PreviewMouseDown" />
            <EventSetter Event="PreviewMouseMove" Handler="ShortcutButton_PreviewMouseMove" />
            <EventSetter Event="PreviewMouseUp" Handler="ShortcutButton_PreviewMouseUp" />
            <EventSetter Event="LostMouseCapture" Handler="ShortcutButton_LostMouseCapture" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ShortcutFocusVisualStyle}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ContentTemplate" Value="{StaticResource GridShortcutContentTemplate}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="IconRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="TileTranslate" Y="0" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="IconRoot" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type controls:AdaptiveIconPanel}}}"
                             Value="{x:Static models:OrganizerIconLayoutMode.List}">
                    <Setter Property="ContentTemplate" Value="{StaticResource ListShortcutContentTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="SizeNWSE" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path x:Name="HandleMarks"
                                  Width="10"
                                  Height="10"
                                  Margin="6"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Data="M 1,10 L 10,1 M 5,10 L 10,5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                  StrokeThickness="1.35"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Opacity="0.76" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HandleMarks" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=OrganizerSurface}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconsOnlyMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="True">
                    <Setter Property="Opacity" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#F226292D" />
            <Setter Property="Foreground" Value="#F3F4F5" />
            <Setter Property="BorderBrush" Value="#32FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F1F2F3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuSurface"
                                MinWidth="188"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="CheckMark"
                                      Width="10"
                                      Height="8"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Data="M 1,4 L 4,7 L 9,1"
                                      Stroke="#F4F5F6"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuSurface" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MenuSurface" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#20FFFFFF" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="ShortcutContextMenu"
                     Style="{StaticResource DarkContextMenuStyle}"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="移至默认整理块"
                      Style="{StaticResource DarkMenuItemStyle}"
                      Click="RemoveShortcut_Click" />
        </ContextMenu>

    </Window.Resources>

    <Border x:Name="OrganizerSurface"
            Background="#DE2D3238"
            BorderThickness="0"
            CornerRadius="0"
            AllowDrop="True"
            MouseEnter="OrganizerSurface_MouseEnter"
            MouseLeave="OrganizerSurface_MouseLeave"
            PreviewMouseLeftButtonDown="OrganizerSurface_PreviewMouseLeftButtonDown"
            DragOver="OrganizerSurface_DragOver"
            Drop="OrganizerSurface_Drop">
        <Border.ContextMenu>
            <ContextMenu x:Name="OrganizerMenu"
                         Style="{StaticResource DarkContextMenuStyle}"
                         Opened="OrganizerMenu_Opened">
                <MenuItem Header="新建整理块"
                          Style="{StaticResource DarkMenuItemStyle}"
                          Click="NewOrganizer_Click" />
                <MenuItem Header="归类桌面项目…"
                          Style="{StaticResource DarkMenuItemStyle}"
                          Click="AssignDesktopItems_Click" />
                <Separator Style="{StaticResource DarkSeparatorStyle}" />
                <MenuItem Header="重命名整理块…"
                          Style="{StaticResource DarkMenuItemStyle}"
                          Click="RenameOrganizer_Click" />
                <MenuItem Header="外观与吸附…"
                          Style="{StaticResource DarkMenuItemStyle}"
                          Click="AppearanceSettings_Click" />
                <MenuItem Header="打开桌面目录"
                          Style="{StaticResource DarkMenuItemStyle}"
                          Click="OpenDesktopFolder_Click" />
                <Separator Style="{StaticResource DarkSeparatorStyle}" />
                <MenuItem x:Name="StartWithWindowsItem"
                          Header="登录 Windows 时启动"
                          Style="{StaticResource DarkMenuItemStyle}"
                          IsCheckable="True"
                          Click="StartWithWindows_Click" />
                <MenuItem Header="恢复默认大小"
                          Style="{StaticResource DarkMenuItemStyle}"
                          Click="ResetSize_Click" />
                <MenuItem Header="隐藏整理块"
                          Style="{StaticResource DarkMenuItemStyle}"
                          Click="Hide_Click" />
                <Separator Style="{StaticResource DarkSeparatorStyle}" />
                <MenuItem x:Name="DeleteOrganizerItem"
                          Header="删除当前整理块…"
                          Style="{StaticResource DarkMenuItemStyle}"
                          Click="DeleteOrganizer_Click" />
                <MenuItem Header="退出"
                          Style="{StaticResource DarkMenuItemStyle}"
                          Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid ClipToBounds="True">
            <Grid x:Name="OrganizerContent">
                <TextBlock x:Name="FolderNameText"
                           Panel.ZIndex="2"
                           Margin="19,11,42,0"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"
                           Opacity="0" />

                <ScrollViewer x:Name="ShortcutScroller"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              CanContentScroll="False"
                              Focusable="False"
                              PanningMode="VerticalOnly"
                              PanningDeceleration="0.002"
                              PreviewMouseWheel="ShortcutScroller_PreviewMouseWheel">
                <ItemsControl x:Name="ShortcutItems" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AdaptiveIconPanel ShowLabels="{Binding ShowIconNames, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        SuppressLabels="{Binding IconsOnlyMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        LayoutMode="{Binding IconLayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ShortcutButtonStyle}"
                                    Content="{Binding}"
                                    ContextMenu="{StaticResource ShortcutContextMenu}"
                                    ToolTip="{Binding Name}"
                                    AutomationProperties.Name="{Binding Name}"
                                    Click="Shortcut_Click">
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>

                <Thumb x:Name="ResizeThumb"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,5,5"
                       Style="{StaticResource ResizeThumbStyle}"
                       AutomationProperties.Name="调整整理块大小"
                       DragStarted="ResizeThumb_DragStarted"
                       DragDelta="ResizeThumb_DragDelta"
                       DragCompleted="ResizeThumb_DragCompleted" />

                <Border x:Name="ToastHost"
                        Panel.ZIndex="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="18"
                        Padding="12,7"
                        Background="#F0272A2E"
                        BorderBrush="#2CFFFFFF"
                        BorderThickness="1"
                        CornerRadius="9"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ToastTranslate" Y="6" />
                    </Border.RenderTransform>
                    <TextBlock x:Name="ToastText"
                               FontSize="13"
                               Foreground="#F7F8F9"
                               TextAlignment="Center" />
                </Border>
            </Grid>

            <TextBlock x:Name="LiveStatus"
                       Width="1"
                       Height="1"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Opacity="0"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </Border>
</Window>
