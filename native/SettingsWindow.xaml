<Window x:Class="YitDesktopFold.Native.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外观与吸附"
        Width="390"
        Height="610"
        MinHeight="280"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="#262A2E"
        ShowInTaskbar="True"
        Topmost="False"
        FontFamily="{StaticResource UiFont}"
        Foreground="#F1F2F3"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AutomationProperties.Name="外观与整理块设置"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="#E9EAEB" />
            <Setter Property="Background" Value="#16FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.68" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#2DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Background" Value="#ECEDEF" />
            <Setter Property="Foreground" Value="#25292D" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="HiddenRestoreButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#16FFFFFF" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="CloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="34" Height="18" Background="Transparent">
                            <Border x:Name="Track"
                                    Background="#3A3E42"
                                    CornerRadius="9" />
                            <Ellipse x:Name="Thumb"
                                     Width="14"
                                     Height="14"
                                     Margin="2"
                                     HorizontalAlignment="Left"
                                     Fill="#AEB4B7BA" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#87909599" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#E0E2E3E4" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#62686D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderDecreaseButtonStyle" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="3"
                                VerticalAlignment="Center"
                                Background="#A5E4E6E8"
                                CornerRadius="1.5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderIncreaseButtonStyle" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="3"
                                VerticalAlignment="Center"
                                Background="#28FFFFFF"
                                CornerRadius="1.5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Surface"
                                Width="12"
                                Height="12"
                                Background="#ECEDEF"
                                CornerRadius="6" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.76" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderDecreaseButtonStyle}"
                                                  Command="{x:Static Slider.DecreaseLarge}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderIncreaseButtonStyle}"
                                                  Command="{x:Static Slider.IncreaseLarge}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.34" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="NumericTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F2F3F4" />
            <Setter Property="CaretBrush" Value="#F2F3F4" />
            <Setter Property="SelectionBrush" Value="#66787C80" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MaxLength" Value="3" />
        </Style>

        <Style x:Key="ToneOptionStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="#C9CCCED1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ToneSurface"
                                Padding="12,0"
                                Background="Transparent"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToneSurface" Property="Background" Value="#20FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToneSurface" Property="Background" Value="#ECEDEF" />
                                <Setter Property="Foreground" Value="#25292D" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToneSurface" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowSurface"
            Background="#FA262A2E"
            BorderThickness="0"
            CornerRadius="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="54" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="16,0,10,0"
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#F4F5F6"
                           Text="外观与吸附" />
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource CloseButtonStyle}"
                        Content="×"
                        AutomationProperties.Name="关闭设置"
                        Click="CloseButton_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly">
            <StackPanel Margin="16,0">
                <Border Height="36"
                        Padding="10,0"
                        Background="#1821262A"
                        CornerRadius="7">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="#AEB7BABD"
                               Text="外观与吸附会即时同步到全部整理块。" />
                </Border>

                <Grid Height="28" Margin="2,8,2,0">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#E6E8E9"
                               Text="毛玻璃" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock x:Name="GlassStateText"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="#9FA5A9AC" />
                        <CheckBox x:Name="GlassToggle"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  AutomationProperties.Name="毛玻璃开关"
                                  Checked="Toggle_Changed"
                                  Unchecked="Toggle_Changed" />
                    </StackPanel>
                </Grid>

                <StackPanel>
                    <Grid Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="94" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="104" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="#C9CCCED1"
                                   Text="块背景透明度" />
                        <Slider x:Name="BackgroundTransparencySlider"
                                Grid.Column="1"
                                Margin="6,0,10,0"
                                Minimum="0"
                                Maximum="100"
                                SmallChange="1"
                                LargeChange="5"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Style="{StaticResource CompactSliderStyle}"
                                AutomationProperties.Name="块背景透明度"
                                AutomationProperties.HelpText="0% 为不透明，100% 为完全透明"
                                ValueChanged="Slider_ValueChanged" />
                        <Border Grid.Column="2"
                                Height="28"
                                Background="#68202327"
                                CornerRadius="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource StepButtonStyle}"
                                        Content="−"
                                        Tag="Background:-1"
                                        AutomationProperties.Name="降低背景透明度"
                                        Click="StepButton_Click" />
                                <TextBox x:Name="BackgroundTransparencyTextBox"
                                         Grid.Column="1"
                                         Style="{StaticResource NumericTextBoxStyle}"
                                         AutomationProperties.Name="背景透明度数值"
                                         AutomationProperties.HelpText="输入 0 到 100；0% 为不透明，100% 为完全透明"
                                         TextChanged="NumericTextBox_TextChanged"
                                         PreviewTextInput="NumericTextBox_PreviewTextInput"
                                         PreviewKeyDown="NumericTextBox_PreviewKeyDown"
                                         LostKeyboardFocus="NumericTextBox_LostKeyboardFocus"
                                         PreviewMouseWheel="NumericTextBox_PreviewMouseWheel" />
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="#AEB4B7BA"
                                           Text="%" />
                                <Button Grid.Column="3"
                                        Style="{StaticResource StepButtonStyle}"
                                        Content="+"
                                        Tag="Background:1"
                                        AutomationProperties.Name="提高背景透明度"
                                        Click="StepButton_Click" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="94" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="#C9CCCED1"
                                   Text="背景底色" />
                        <Border Grid.Column="1"
                                Height="30"
                                Padding="1"
                                VerticalAlignment="Center"
                                Background="#68202327"
                                CornerRadius="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="DarkToneOption"
                                             Grid.Column="0"
                                             Content="黑色"
                                             GroupName="BackgroundTone"
                                             Style="{StaticResource ToneOptionStyle}"
                                             AutomationProperties.Name="黑色背景底色"
                                             Checked="BackgroundTone_Changed" />
                                <RadioButton x:Name="LightToneOption"
                                             Grid.Column="1"
                                             Content="白色"
                                             GroupName="BackgroundTone"
                                             Style="{StaticResource ToneOptionStyle}"
                                             AutomationProperties.Name="白色背景底色"
                                             Checked="BackgroundTone_Changed" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <Grid Height="46" Margin="2,4,2,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="12.5"
                                   Foreground="#E6E8E9"
                                   Text="磁吸吸附" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="10.5"
                                   Foreground="#92989C9F"
                                   Text="移动整理块时贴合相邻边缘" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock x:Name="MagnetStateText"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="#9FA5A9AC" />
                        <CheckBox x:Name="MagnetToggle"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  AutomationProperties.Name="磁吸吸附开关"
                                  Checked="Toggle_Changed"
                                  Unchecked="Toggle_Changed" />
                    </StackPanel>
                </Grid>

                <Border Height="1"
                        Margin="2,4,2,0"
                        Background="#18FFFFFF" />

                <Grid Height="28" Margin="2,2,2,0">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#E6E8E9"
                               Text="应用" />
                </Grid>

                <Grid Height="46" Margin="2,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="11.5"
                                   Foreground="#C9CCCED1"
                                   Text="登录 Windows 时启动" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="10"
                                   Foreground="#7F898E92"
                                   Text="保存后写入当前用户启动项" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock x:Name="StartupStateText"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="#9FA5A9AC" />
                        <CheckBox x:Name="StartupToggle"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  AutomationProperties.Name="登录 Windows 时启动"
                                  Checked="StartupToggle_Changed"
                                  Unchecked="StartupToggle_Changed" />
                    </StackPanel>
                </Grid>

                <Border Height="1"
                        Margin="2,4,2,0"
                        Background="#18FFFFFF" />

                <Grid Height="28" Margin="2,2,2,0">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#E6E8E9"
                               Text="当前整理块" />
                    <TextBlock x:Name="CurrentFolderNameText"
                               Width="210"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               FontSize="10.5"
                               Foreground="#92989C9F" />
                </Grid>

                <Grid Height="42" Margin="2,0">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="#C9CCCED1"
                               Text="图标布局" />
                    <Border Width="236"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="1"
                            Background="#68202327"
                            CornerRadius="7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="LargeLayoutOption"
                                         Grid.Column="0"
                                         Content="大"
                                         GroupName="IconLayoutMode"
                                         Style="{StaticResource ToneOptionStyle}"
                                         AutomationProperties.Name="大图标布局"
                                         Checked="IconLayoutMode_Changed" />
                            <RadioButton x:Name="MediumLayoutOption"
                                         Grid.Column="1"
                                         Content="中"
                                         GroupName="IconLayoutMode"
                                         Style="{StaticResource ToneOptionStyle}"
                                         AutomationProperties.Name="中图标布局"
                                         Checked="IconLayoutMode_Changed" />
                            <RadioButton x:Name="SmallLayoutOption"
                                         Grid.Column="2"
                                         Content="小"
                                         GroupName="IconLayoutMode"
                                         Style="{StaticResource ToneOptionStyle}"
                                         AutomationProperties.Name="小图标布局"
                                         Checked="IconLayoutMode_Changed" />
                            <RadioButton x:Name="ListLayoutOption"
                                         Grid.Column="3"
                                         Content="列表"
                                         GroupName="IconLayoutMode"
                                         Style="{StaticResource ToneOptionStyle}"
                                         AutomationProperties.Name="列表布局"
                                         Checked="IconLayoutMode_Changed" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Height="34" Margin="2,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="11.5"
                                   Foreground="#C9CCCED1"
                                   Text="隐藏边框和背景" />
                        <TextBlock Margin="0,1,0,0"
                                   FontSize="9.5"
                                   Foreground="#7F898E92"
                                   Text="只保留高清图标" />
                    </StackPanel>
                    <CheckBox x:Name="IconsOnlyToggle"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="隐藏当前整理块边框和背景"
                              Checked="DisplayToggle_Changed"
                              Unchecked="DisplayToggle_Changed" />
                </Grid>

                <Grid Height="34" Margin="2,0">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="#C9CCCED1"
                               Text="显示文件夹名称" />
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock x:Name="FolderNameModeHint"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="#92989C9F" />
                        <CheckBox x:Name="ShowFolderNameToggle"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  AutomationProperties.Name="显示当前整理块文件夹名称"
                                  Checked="DisplayToggle_Changed"
                                  Unchecked="DisplayToggle_Changed" />
                    </StackPanel>
                </Grid>

                <Grid Height="34" Margin="2,0">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="#C9CCCED1"
                               Text="显示图标名称" />
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock x:Name="IconNamesModeHint"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="#92989C9F" />
                        <CheckBox x:Name="ShowIconNamesToggle"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  AutomationProperties.Name="显示当前整理块图标名称"
                                  Checked="DisplayToggle_Changed"
                                  Unchecked="DisplayToggle_Changed" />
                    </StackPanel>
                </Grid>

                <Border Height="1"
                        Margin="2,4,2,0"
                        Background="#18FFFFFF" />

                <Grid Height="28" Margin="2,2,2,0">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#E6E8E9"
                               Text="隐藏整理块" />
                    <TextBlock x:Name="HiddenOrganizerCountText"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="10.5"
                               Foreground="#92989C9F" />
                </Grid>

                <Border x:Name="HiddenOrganizerHost"
                        MinHeight="36"
                        MaxHeight="74"
                        Margin="2,0"
                        Padding="4"
                        Background="#3421262A"
                        CornerRadius="7"
                        AutomationProperties.Name="隐藏整理块列表">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="True">
                        <StackPanel x:Name="HiddenOrganizerList" />
                    </ScrollViewer>
                </Border>

                <TextBlock x:Name="InlineStatus"
                           Height="18"
                           Margin="2,3,2,0"
                           VerticalAlignment="Center"
                           FontSize="10.5"
                           Foreground="#E0B2AA"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="16,8,16,14">
                <Button HorizontalAlignment="Left"
                        Style="{StaticResource FlatButtonStyle}"
                        Background="Transparent"
                        Content="恢复默认"
                        AutomationProperties.Name="恢复默认外观"
                        Click="ResetButton_Click" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="68"
                            Margin="0,0,8,0"
                            Style="{StaticResource FlatButtonStyle}"
                            Content="取消"
                            Click="CancelButton_Click" />
                    <Button Width="68"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="保存"
                            Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
